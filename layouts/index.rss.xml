{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <description>{{ site.Params.description }}</description>
    <link>{{ site.Home.Permalink }}</link>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <generator>Hugo {{ hugo.Version }}</generator>
    {{- range first 10 (where site.RegularPages "Section" "posts") }}
      <item>
        <title>{{ .Title }}</title>
        <description>{{ .Content | html }}</description>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        <link>{{ partial "clean-url.html" .Permalink }}</link>
        <guid isPermaLink="true">{{ partial "clean-url.html" .Permalink }}</guid>
        {{- range .Params.tags }}
        <category>{{ . }}</category>
        {{- end }}
      </item>
    {{- end }}
  </channel>
</rss>
